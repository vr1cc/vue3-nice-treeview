{
  "name": "vue3-nice-treeview",
  "version": "0.1.3",
  "description": "An easy to use treeview for vue3 with practical features",
  "private": false,
  "main": "dist/vue3-nice-treeview.umd.js",
  "module": "dist/vue3-nice-treeview.es.js",
  "unpkg": "dist/vue3-nice-treeview.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue3-nice-treeview.es.js",
      "require": "./dist/vue3-nice-treeview.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "dist/style.css"
  ],
  "scripts": {
    "build": "vite build && node -e \"require('fs').copyFileSync('src/index.d.ts','dist/index.d.ts')\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "bootstrap-icons": "1.11.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.0",
    "vite": "^4.5.0",
    "vue": "^3.4.37",
    "bootstrap-icons": "1.11.0"
  },
  "keywords": ["vue3", "vue", "treeview", "tree", "component", "ui", "select", "multiselect", "checkbox", "highlight"],
  "author": "Milad Poursaleh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vr1cc/vue3-nice-treeview.git"
  },
  "homepage": "https://github.com/vr1cc/vue3-nice-treeview#readme",
  "bugs": {
    "url": "https://github.com/vr1cc/vue3-nice-treeview/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}